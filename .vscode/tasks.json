{
    "version": "2.0.0",
    "tasks": [
        {
            // Default build task (Ctrl+Shift+B). Driven by the CMake Tools
            // extension, so it uses whatever preset/target is selected in the
            // status bar.
            "label": "CMake: build",
            "type": "cmake",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile", "$gcc"]
        }
    ]
}
