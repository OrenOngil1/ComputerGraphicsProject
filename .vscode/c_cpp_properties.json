{
    "configurations": [
        {
            "name": "Default",
            // Pull include paths / defines / standard from the live CMake
            // build instead of hardcoding them. Works on any OS and stays in
            // sync with CMakeLists. The fields below are only a fallback for
            // when CMake Tools hasn't configured yet.
            "configurationProvider": "ms-vscode.cmake-tools",
            "includePath": [
                "/usr/include/opencv4",
                "/usr/include/GLFW",
                "${workspaceFolder}/**",
                "${workspaceFolder}/include",
                "${workspaceFolder}/external/engine",
                "${workspaceFolder}/external/glad/include"
            ],
            "compilerPath": "/usr/bin/g++",
            "cppStandard": "c++17"
        }
    ],
    "version": 4
}